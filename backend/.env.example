# API externa 
TMDB_API_KEY=

# URL em que a aplicação está rodando
# necessário para o retorno da url de foto de perfil do usuário
BASE_URL=http://localhost:8000

# Banco de dados
DATABASE=moviescore
DB_USERNAME=root
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=3306
# Necessário para subir o docker compose
MYSQL_ROOT_PASSWORD=

# JWT
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=30